# Backend (BeingHuman-BE) that Next.js proxies /api and /media to
API_URL=http://localhost:4000
# To open the dev server from a phone, put this computer's LAN/Tailscale IP here (comma-separated)
ALLOWED_DEV_ORIGINS=
# Pin the elder's id; "demo" shows the seeded photos. Leave empty to use a per-device id.
NEXT_PUBLIC_USER_ID=demo
