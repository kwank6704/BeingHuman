# Backend (BeingHuman-BE) that Next.js proxies /api and /media to
API_URL=http://localhost:4000
# To open the dev server from a phone, put this computer's LAN/Tailscale IP here (comma-separated)
ALLOWED_DEV_ORIGINS=
# LIFF app ID (LINE Developers → LINE Login channel → LIFF). Set it to log in with LINE; the backend then
# needs LINE_CHANNEL_ID. Empty = no LINE login, use NEXT_PUBLIC_USER_ID / a per-device id (local development).
NEXT_PUBLIC_LIFF_ID=
# Without LINE login: pin the elder's id; "demo" shows the seeded photos. Leave empty to use a per-device id.
NEXT_PUBLIC_USER_ID=demo
